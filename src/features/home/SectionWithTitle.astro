---
import HeaderLine from "@components/HeaderLine.astro";
import { cn } from "@lib/utils";

import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  contentWrapperClass?: string;
}

const { title, class: className, contentWrapperClass, ...attrs } = Astro.props;
---

<section
  class={cn("relative flex h-dvh max-h-dvh w-full min-w-full flex-col", className)}
  {...attrs}
>
  <HeaderLine title={title ?? ""} classes={{ container: "w-[101%]" }} />
  <div class={cn("relative z-10 m-4 min-h-0 flex-1", contentWrapperClass)}>
    <slot />
  </div>
  <slot name="after-content" />
</section>
