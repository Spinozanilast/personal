---
import { cn } from "@lib/utils";

import SquareBracket from "@assets/square_bracket.svg";

interface Props {
  title: string;
  link: string;
  description?: string;
  separateTab?: boolean;
  className?: string;
  audioSrc?: string;
}

const {
  title,
  description,
  link,
  separateTab = true,
  className,
  audioSrc,
} = Astro.props;
---

<a
  class="reference-link text-foreground-accent-red font-departuremono text-dm-sm w-full min-w-1/3 font-medium focus:scale-[1.1]"
  data-audioSrc={audioSrc}
  href={link}
  target={separateTab ? "_blank" : ""}
>
  <div
    class="reference group fill-foreground-accent-red flex h-25 max-h-60 max-w-full min-w-max flex-row justify-between hover:scale-[1.1] active:scale-[1.1]"
  >
    <SquareBracket class="bracket-icon" />
    <div
      title={description}
      class={cn(
        "reference-content text-foreground flex flex-row items-center justify-center gap-[0.5em] text-3xl",
        className,
      )}
    >
      <slot />

      {title}
    </div>
    <SquareBracket class="bracket-icon rotate-180" />
  </div>
</a>

<script>
  import AudioPlayer from "@lib/audio.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const referenceLinks =
      document.querySelectorAll<HTMLAnchorElement>(".reference-link");

    referenceLinks.forEach((link) => {
      const audioSrc = link.dataset.audiosrc;

      if (audioSrc && audioSrc?.length !== 0) {
        AudioPlayer.createAudioPlayer(audioSrc);

        link.addEventListener("mouseenter", () => {
          console.log(audioSrc);
          AudioPlayer.playAudio(audioSrc);
        });
      }
    });
  });
</script>

<style>
  @reference "../../global.css";

  .reference-content {
    @apply text-foreground flex flex-row items-center justify-center gap-[0.5em] text-3xl;

    svg {
      @apply max-w-16 min-w-2;

      @media (width <= 700px) {
        @apply w-12;
      }
    }

    @media (width <= 700px) {
      @apply flex-col text-xl;
    }
  }

  @media (width <= 500px) {
    .reference {
      @apply h-full w-full justify-center;

      svg {
        @apply w-32;
      }
    }

    .bracket-icon {
      @apply hidden;
    }
  }
</style>
