---
import { cn } from "@lib/utils";

import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  iconName?: string;
  title?: string;
  enableTitleOnBackground?: boolean;
  withBorder?: boolean;
}

const {
  iconName,
  title,
  enableTitleOnBackground = false,
  withBorder = true,
  class: className,
  ...attrs
} = Astro.props;
---

<section class={cn(className, "group", withBorder && "with-border")} {...attrs}>
  {
    iconName && (
      <div class="absolute top-2 left-2 size-8 md:size-12">
        <Icon
          width="100%"
          height="auto"
          name={iconName}
          class="text-section-secondary opacity-80 group-hover:opacity-100"
        />
      </div>
    )
  }
  <slot />
</section>

<style
  define:vars={{
    titleText: `"${enableTitleOnBackground ? title?.toUpperCase() : ""}"`,
  }}
>
  @reference "../../global.css";

  section {
    @apply relative flex h-fit w-[67.5vw] flex-col items-center justify-center gap-1.5 py-4 md:flex-row;

    &::before {
      @apply font-pixelify absolute z-[-1000] text-[calc(max(1vw,1vh)*10)] opacity-20 blur-xs content-(--titleText);
    }

    &.with-border {
      @apply border-section-secondary border-2 border-dashed opacity-80;
    }
  }
</style>
