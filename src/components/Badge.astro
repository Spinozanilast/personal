---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

type Variant = "default" | "accent" | "success" | "warning" | "danger" | "info";

interface Props extends HTMLAttributes<"span"> {
  variant?: Variant;
}

const { variant = "default", class: className, ...attrs } = Astro.props;
---

<span class={cn("badge", `badge-${variant}`, className)} {...attrs}>
  <slot />
</span>

<style>
  @reference "../global.css";

  .badge {
    @apply inline-flex items-center rounded-full px-3 py-1 font-manrope text-xs font-semibold;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    white-space: nowrap;

    &:hover {
      transform: translateY(-1px);
    }
  }

  .badge-default {
    background: var(--section-background);
    border-color: var(--section-secondary);
    color: var(--text-color);
  }

  .badge-accent {
    background: color-mix(in srgb, var(--accent-color) 15%, transparent);
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .badge-success {
    background: color-mix(in srgb, var(--actions) 15%, transparent);
    border-color: var(--actions);
    color: var(--actions);
  }

  .badge-warning {
    background: color-mix(in srgb, #f59e0b 15%, transparent);
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .badge-danger {
    background: color-mix(in srgb, var(--red-accent-color) 15%, transparent);
    border-color: var(--red-accent-color);
    color: var(--red-accent-color);
  }

  .badge-info {
    background: color-mix(in srgb, var(--blue-accent-color) 15%, transparent);
    border-color: var(--blue-accent-color);
    color: var(--blue-accent-color);
  }
</style>
