---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

type Variant = "default" | "accent" | "success" | "warning" | "danger" | "info";

interface Props extends HTMLAttributes<"span"> {
  variant?: Variant;
}

const { variant = "default", class: className, ...attrs } = Astro.props;
---

<span class={cn("badge", `badge-${variant}`, className)} {...attrs}>
  <slot />
</span>

<style>
  @reference "../global.css";

  .badge {
    @apply font-manrope inline-flex items-center rounded-full border border-solid border-transparent px-3 py-1 text-xs font-semibold whitespace-nowrap transition-all duration-200;

    &:hover {
      transform: translateY(-1px);
    }
  }

  .badge-default {
    @apply bg-section-background border-section-secondary;
  }

  .badge-accent {
    @apply border-accent text-accent;
    background: color-mix(in srgb, var(--accent-color) 15%, transparent);
  }

  .badge-success {
    @apply text-actions border-actions;
    background: color-mix(in srgb, var(--actions) 15%, transparent);
  }

  .badge-warning {
    @apply border-[#f59e0b] text-[#f59e0b];
    background: color-mix(in srgb, #f59e0b 15%, transparent);
  }

  .badge-danger {
    @apply text-foreground-top-accent border-foreground-top-accent;
    background: color-mix(in srgb, var(--top-accent-color) 15%, transparent);
  }

  .badge-info {
    @apply text-foreground-bottom-accent border-foreground-bottom-accent;
    background: color-mix(in srgb, var(--bottom-accent-color) 15%, transparent);
  }
</style>
