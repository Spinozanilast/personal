---
type Props = {
  current: "ru" | "en";
};

const { current } = Astro.props;
---

<div
  class="language-selector bg-section-background border-accent/20 font-departuremono text-dm-sm inline-flex gap-1 rounded-lg border-2 p-1 backdrop-blur-sm"
>
  <a
    href="/cv"
    class:list={[
      "rounded-md px-3 py-1 transition-all hover:scale-105",
      current === "ru"
        ? "text-accent bg-actions-background font-bold"
        : "opacity-60 hover:opacity-100",
    ]}
  >
    RU
  </a>
  <a
    href="/cv/en"
    class:list={[
      "rounded-md px-3 py-1 transition-all hover:scale-105",
      current === "en"
        ? "text-accent bg-actions-background font-bold"
        : "opacity-60 hover:opacity-100",
    ]}
  >
    EN
  </a>
</div>
