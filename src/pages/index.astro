---
import Layout from "@/layouts/BaseLayout.astro";

import Reference from "@features/welcome/Reference.astro";
import Section from "@features/welcome/SectionWithBG.astro";

import GithubIcon from "@assets/icons/brands/github.svg";
import TelegramIcon from "@assets/icons/brands/telegram.svg";
import EmailIcon from "@assets/icons/email.svg";
import BookIcon from "@assets/icons/book.svg";
import HomeIcon from "@assets/icons/home.svg";
import CvIcon from "@assets/icons/cv.svg";
import WaveAnimation from "@assets/wave_animation.svg";

import PaperTouchAudioSrc from "@assets/audio/paper_touch.mp3";
import DoorCreaksAudioSrc from "@assets/audio/door_creaks.mp3";
import OpeningBookAudioSrc from "@assets/audio/opening_book.mp3";
---

<script>
  import Typewriter from "@lib/typewriter";

  const typewriter = new Typewriter(false);

  document.addEventListener("DOMContentLoaded", () => {
    typewriter.setupTypewriterFromElementWithInnerText(
      document.getElementById("nickname-self") as HTMLHeadingElement,
    );
  });
</script>

<Layout title="Welcome">
  <main class="flex flex-col items-center justify-center pb-20 md:pb-0">
    <WaveAnimation class="wave-animation" />
    <section id="nickname">
      <h1
        id="nickname-self"
        class="md:font-extrude font-pixelify mt-10 flex w-full min-w-max text-center text-[12vw] font-bold -tracking-widest uppercase hover:tracking-normal md:flex-row"
      >
        <span class="text-foreground-bottom-accent relative">s</span>
        <span class="text-foreground-top-accent relative">p</span>
        <span class="text-foreground-bottom-accent relative">i</span>
        <span class="text-foreground-top-accent relative">n</span>
        <span class="text-foreground-bottom-accent relative">o</span>
        <span class="text-foreground-top-accent relative">z</span>
        <span class="text-foreground-bottom-accent relative">a</span>
        <span class="text-foreground-top-accent relative">n</span>
        <span class="text-foreground-bottom-accent relative">i</span>
        <span class="text-foreground-top-accent relative">l</span>
        <span class="text-foreground-bottom-accent relative">a</span>
        <span class="text-foreground-top-accent relative">s</span>
        <span class="text-foreground-bottom-accent relative">t</span>
      </h1>
      <div
        class="horizontal-line bg-logo-underline relative bottom-6.25 mt-[0.5em] h-[calc(min(1vw,2vh)/1)] w-full rounded-md"
      >
      </div>
    </section>
    <Section
      title="Links"
      class="bg-section-background rounded-xl"
      iconName={"link"}
      enableTitleOnBackground
      bigIconTitleModeEnabled
    >
      <Fragment slot="content">
        <a href="https://github.com/spinozanilast" class="link" target="_blank">
          <GithubIcon />
          <span class="block">Github</span>
        </a>
        <a href="https://t.me/spinozanilast" class="link" target="_blank">
          <TelegramIcon />
          <span class="block">Telegram</span>
        </a>
        <a href="mailto:spinozanilast@proton.me" class="link">
          <EmailIcon />
          <span class="block">Email</span>
        </a>
      </Fragment>
    </Section>
    <Section
      id="navigation"
      title="Navigation"
      iconName="navigation"
      enableTitleOnBackground
      bigIconTitleModeEnabled
      class="bg-section-background container rounded-xl"
    >
      <Fragment slot="content">
        <Reference
          audioSrc={DoorCreaksAudioSrc}
          title="Home"
          link="/home"
          separateTab={false}><HomeIcon /></Reference
        >
        <Reference
          audioSrc={OpeningBookAudioSrc}
          title="Notes"
          link="/notes"
          separateTab={false}><BookIcon /></Reference
        >
        <Reference
          audioSrc={PaperTouchAudioSrc}
          title="CV"
          link="/cv"
          separateTab={false}><CvIcon /></Reference
        >
      </Fragment>
    </Section>
  </main>
</Layout>

<style>
  @reference "../global.css";

  main > section:not(:first-of-type) {
    @apply my-2.5 max-w-3/4 min-w-3/4 md:min-h-[25vh];
  }

  main > section:first-of-type {
    @apply top-4 my-2.5 mt-8 max-h-[30vh];
  }

  section#nickname {
    @apply flex w-fit flex-col items-end justify-center p-4;
  }

  #nickname-self {
    transition: letter-spacing 1s ease-in-out;
    > span {
      transition: all var(--standard-animation-duration);
    }
    @media (width >= 450px) {
      span {
        -webkit-text-stroke: var(--logo-stroke) 5px;
      }
    }
  }

  section#navigation.container {
    @apply flex flex-row items-center justify-center gap-2 px-20 py-6;

    @media (width <= 700px) {
      @apply px-4 py-5;
    }

    @media (width <= 1300px) {
      @apply flex-col;
    }
  }

  svg {
    @apply h-full w-full;
  }

  @media (max-width: 768px) {
    .horizontal-line {
      bottom: 0.625rem;
    }
  }

  :global(span.letter-glow) {
    @apply text-shadow-lg;
  }

  @media screen and (max-width: 768px) {
    section#links {
      > a {
        @apply h-34 w-34;
      }
    }
  }

  @media (width <= 500px) {
    section#navigation.container {
      @apply flex flex-col items-center justify-center px-4 py-1;
    }
  }

  .link {
    @apply h-28 flex-col md:h-[7em];
  }
</style>
