---
import HomeLayout from "@layouts/HomeLayout.astro";
import HeaderLine from "@components/HeaderLine.astro";
import ProjectCard from "@features/projects/ProjectCard.astro";

import { projects } from "@data/projects";
import { Icon } from "astro-icon/components";
---

<HomeLayout title="Projects">
  <HeaderLine
    title="Projects"
    classes={{ title: "text-center", container: "justify-center mx-4 rounded-md" }}
  >
    <Icon name="projects" slot="title-extra" class="text-accent/90 size-20" />
  </HeaderLine>
  <section class="mx-auto max-w-280 p-6">
    <p
      class="bg-section-background text-foreground font-departuremono text-dm-xs w-full p-4 leading-relaxed text-balance"
    >
      Some things I've been building between writing code, writing stuff and making art.
      For everything else there is {" "}
      <a
        class="text-accent underline underline-offset-2"
        href="https://github.com/Spinozanilast"
        target="_blank"
      >
        GitHub
      </a>.
    </p>
    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} detailed />)}
    </div>
  </section>
</HomeLayout>
